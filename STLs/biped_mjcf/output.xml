<mujoco model="biped-URDF-fixed">
  <default>
    <default class="robot">
      <default class="visual">
        <geom contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom contype="0" conaffinity="1" group="3" />
      </default>
    </default>
    <default class="floor">
      <geom type="plane" size="0 0 0.05" material="groundplane" />
    </default>
  </default>

  <compiler angle="radian" meshdir="." balanceinertia="true" />

  <visual>
    <global offwidth="3840" offheight="2160" />
  </visual>

  <worldbody>
    <body name="base_link" childclass="robot" pos="0 0 0.1005">
      <geom name="base_link_collision" type="mesh" mesh="base_link_collision_base_link" class="collision" />
      <geom name="base_link_visual" type="mesh" mesh="base_link_base_link" material="default_material" class="visual" />
      <body name="L_thigh_link" pos="0 -0.0525 0.0975" quat="0.961 0 0 -0.2765">
        <inertial pos="0.030049 -0.12711 -0.037895" mass="0.26333" diaginertia="0.00036191 0.00012037 0.00042449" />
        <joint name="L_hip_joint" type="hinge" range="-1.57 1.57" axis="0 0 1" />
        <geom name="L_thigh_link_collision" type="mesh" mesh="L_thigh_link_collision_L_thigh_link" class="collision" />
        <geom name="L_thigh_link_visual" type="mesh" mesh="L_thigh_link_L_thigh_link" material="default_material" class="visual" />
        <body name="L_foot_link" pos="0.043239 -0.18296 0" quat="0.993 0 0 0.1184">
          <inertial pos="5.4419E-08 -0.08098 -0.036936" mass="0.17812" diaginertia="0.00033579 5.5113e-05 0.00035765" />
          <joint name="L_knee_joint" type="hinge" range="-1.57 1.57" axis="0 0 1" />
          <geom name="L_foot_link_collision" type="mesh" mesh="L_foot_link_collision_L_foot_link" class="collision" />
          <geom name="L_foot_link_visual" type="mesh" mesh="L_foot_link_L_foot_link" material="default_material" class="visual" />
        </body>
      </body>
      <body name="R_thigh_link" pos="0 -0.0525 -0.1005" quat="0 1 0 0">
        <inertial pos="-0.04144 0.12387 -0.040895" mass="0.26333" diaginertia="0.00034867 0.0001336 0.00042449" />
        <joint name="R_hip_joint" type="hinge" range="-1.57 1.57" axis="0 0 -1" />
        <geom name="R_thigh_link_collision" type="mesh" mesh="R_thigh_link_collision_R_thigh_link" class="collision" />
        <geom name="R_thigh_link_visual" type="mesh" mesh="R_thigh_link_R_thigh_link" material="default_material" class="visual" />
        <body name="R_foot_link" pos="-0.059694 0.17827 -0.003" quat="0.987 0 0 0.1609">
          <inertial pos="0.016404 0.079301 -0.036936" mass="0.17812" diaginertia="0.00032427 6.663e-05 0.00035765" />
          <joint name="R_knee_joint" type="hinge" range="-1.57 1.57" axis="0 0 -1" />
          <geom name="R_foot_link_collision" type="mesh" mesh="R_foot_link_collision_R_foot_link" class="collision" />
          <geom name="R_foot_link_visual" type="mesh" mesh="R_foot_link_R_foot_link" material="default_material" class="visual" />
        </body>
      </body>
      <freejoint name="floating_base" />
    </body>
    <light pos="0 0 2." dir="0 0 -1" directional="true" />
    <geom name="floor" class="floor" size="0 0 0.05" />
  </worldbody>

  <asset>
    <material name="default_material" rgba="0.7 0.7 0.7 1" />
    <mesh name="base_link_collision_base_link" file="meshes/base_link.STL" />
    <mesh name="base_link_base_link" file="meshes/base_link.STL" />
    <mesh name="L_thigh_link_collision_L_thigh_link" file="meshes/L_thigh_link.STL" />
    <mesh name="L_thigh_link_L_thigh_link" file="meshes/L_thigh_link.STL" />
    <mesh name="L_foot_link_collision_L_foot_link" file="meshes/L_foot_link.STL" />
    <mesh name="L_foot_link_L_foot_link" file="meshes/L_foot_link.STL" />
    <mesh name="R_thigh_link_collision_R_thigh_link" file="meshes/R_thigh_link.STL" />
    <mesh name="R_thigh_link_R_thigh_link" file="meshes/R_thigh_link.STL" />
    <mesh name="R_foot_link_collision_R_foot_link" file="meshes/R_foot_link.STL" />
    <mesh name="R_foot_link_R_foot_link" file="meshes/R_foot_link.STL" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
  </asset>

  <actuator>
    <motor name="L_hip_joint" joint="L_hip_joint" />
    <motor name="L_knee_joint" joint="L_knee_joint" />
    <motor name="R_hip_joint" joint="R_hip_joint" />
    <motor name="R_knee_joint" joint="R_knee_joint" />
  </actuator>

  <visual>
    <rgba haze="0.15 0.25 0.35 1" />
  </visual>
</mujoco>