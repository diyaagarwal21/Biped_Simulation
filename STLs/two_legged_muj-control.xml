<mujoco model="biped_fixed_left_foot">
    <compiler angle="degree" inertiafromgeom="false"/>
    <option gravity="0 0 -9.81" timestep="0.001">
        <flag contact="enable"/>
    </option>

    <default>
        <mesh scale="1 1 1"/>
        <geom type="mesh"/>
        <joint type="hinge" limited="true"/>
    </default>

    <asset>
        <mesh name="Hip" file="hip_link.stl"/>
        <mesh name="Left_Thigh" file="L_thigh_link.stl"/>
        <mesh name="Left_Shank" file="L_shank_link.stl"/>
        <mesh name="Right_Thigh" file="R_thigh_link.stl"/>
        <mesh name="Right_Shank" file="R_shank_link.stl"/>
    </asset>

    <worldbody>
        <!-- Fixed left-foot point: no joint on this body. -->
        <body name="LeftFoot" pos="-0.00487 -0.0525 0.02009">
            <geom name="left_foot" type="sphere" size="0.020"
                  friction="2 0.05 0.01" contype="0" conaffinity="0"/>
            <site name="left_foot_contact" size="0.02" rgba="1 0 0 1"/>

            <body name="Shank_l">
                <joint name="left_ankle" axis="0 -1 0" range="-180 180"/>

                <inertial pos="-0.00498442 -0.00922664 0.10346156"
                          mass="0.22845922"
                          fullinertia="0.000339795 0.000362468 6.13674e-05 -6.05095e-07 1.59746e-05 1.13537e-05"/>
                <geom mesh="Left_Shank" pos="-0.01 -0.046 0.19"/>

                <body name="Thigh_l" pos="-0.01 -0.046 0.19">
                    <joint name="knee_joint_l" axis="0 -1 0" range="-90 0"/>

                    <inertial pos="0.0064132 0.036429 0.07969"
                              mass="0.45787"
                              fullinertia="0.00075989 0.00083179 0.00018748 -1.2716e-06 -4.5862e-05 -1.6134e-05"/>
                    <geom mesh="Left_Thigh" pos="0.01487 -0.002 0.18741"/>

                    <body name="Hip" pos="0.01487 -0.002 0.18741">
                        <joint name="hip_joint_l" axis="0 -1 0" range="-90 90"/>

                        <inertial pos="-3.4357e-05 0.1004986797 0.024607"
                                  mass="0.72872"
                                  fullinertia="0.0026253 0.0009619 0.0024818 -2.7249e-08 3.2969e-07 1.1673e-08"/>
                        <geom mesh="Hip" pos="0 0.1005 0.0525"/>

                        <body name="Thigh_r" pos="0 0.201 0">
                            <joint name="hip_joint_r" axis="0 -1 0" range="-90 90"/>

                            <inertial pos="-0.0094938 -0.038429 -0.10763"
                                      mass="0.45787"
                                      fullinertia="0.00075918 0.00083179 0.00018819 1.4171e-06 -5.0112e-05 1.6122e-05"/>
                            <geom mesh="Right_Thigh"/>

                            <body name="Shank_r" pos="-0.016362 -0.002 -0.18729">
                                <joint name="knee_joint_r" axis="0 -1 0" range="0 90"/>

                                <inertial pos="0.0040144 -0.036775 -0.08659"
                                          mass="0.22846"
                                          fullinertia="0.00034012 0.00036247 6.104e-05 4.8444e-07 1.2796e-05 -1.1366e-05"/>
                                <geom mesh="Right_Shank"/>

                                <geom name="right_foot" type="sphere"
                                      pos="0.01 -0.046 -0.19" size="0.020"
                                      friction="5 0.05 0.01"/>
                                <site name="right_foot_contact"
                                      pos="0.01 -0.046 -0.21"
                                      size="0.005" rgba="1 0 0 1"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="knee_joint_left_act" joint="knee_joint_l"
               ctrllimited="true" ctrlrange="-12 12"/>
        <motor name="hip_joint_left_act" joint="hip_joint_l"
               ctrllimited="true" ctrlrange="-12 12"/>
        <motor name="hip_joint_right_act" joint="hip_joint_r"
               ctrllimited="true" ctrlrange="-12 12"/>
        <motor name="knee_joint_right_act" joint="knee_joint_r"
               ctrllimited="true" ctrlrange="-12 12"/>
    </actuator>

    <contact>
        <exclude body1="LeftFoot" body2="Shank_l"/>
        <exclude body1="Shank_l" body2="Thigh_l"/>
        <exclude body1="Thigh_l" body2="Hip"/>
        <exclude body1="Hip" body2="Thigh_r"/>
        <exclude body1="Thigh_r" body2="Shank_r"/>
    </contact>
</mujoco>