<mujoco model="biped">
    <compiler angle="degree" inertiafromgeom="false"/>
    <option gravity="0 0 -9.81">
        <flag contact="enable"/>
    </option>

    <default>
        <mesh scale="1 1 1"/>
        <geom type="mesh"/>
        <joint type="hinge" limited="true" axis="0 1 0"/>
        <position ctrllimited="true" kp="25" kv="0.1"/>
    </default>

    <asset>
        <mesh name="Hip" file="hip_link.stl"/>
        <mesh name="Left_Thigh" file="L_thigh_link.stl"/>
        <mesh name="Left_Shank" file="L_shank_link.stl"/>
        <mesh name="Right_Thigh" file="R_thigh_link.stl"/>
        <mesh name="Right_Shank" file="R_shank_link.stl"/>
    </asset>

    <worldbody>
        <body name="Hip" pos="0 0 0.48">
            <inertial
                pos="-1.6069e-05 -6.3386e-07 -0.040663"
                mass="0.33612"
                fullinertia="0.00064442 0.00032793 0.00061433 
                -3.0404e-08 1.0394e-07 3.0385e-09"/>

            <geom mesh="Hip"/>
            <joint name="base_x" type="slide" axis="1 0 0" limited="false"/>
            <joint name="base_z" type="slide" axis="0 0 1" limited="false"/>
            <joint name="base_pitch" type="hinge" axis="0 1 0" limited="true" range="-0.5 3"/>

            <!-- Right Leg -->
            <body name="Thigh_r"
                pos="0 0.077 -0.0525">

                <inertial
                    pos="-0.00025471 -0.018118 -0.15804"
                    mass="0.1568"
                    fullinertia="0.00013318 0.00017095 5.9825e-05 
                    -1.2548e-08 1.9243e-07 2.0631e-06"/>

                <joint
                    name="hip_joint_r"
                    axis="0 -1 0"
                    limited="true"
                    range="-90 90"/>

                <geom mesh="Right_Thigh"/>

                <body name="Shank_r"
                    pos="0 0 -0.188"
                    euler="0.034907 0 0">

                    <inertial
                        pos="-1.2553e-07 -0.017802 -0.12331"
                        mass="0.071976"
                        fullinertia="8.0507e-05 8.5223e-05 1.6981e-05 
                        -1.3374e-11 1.3431e-10 -2.5123e-06"/>

                    <joint
                        name="knee_joint_r"
                        axis="0 -0.99939 0.034899"
                        limited="true"
                        range="0 143"/>

                    <geom mesh="Right_Shank"/>

                    <geom
                        name="right_foot"
                        type="sphere"
                        pos="0.01 -0.046 -0.19"
                        size="0.020"
                        friction="2 0.05 0.01"/>

                    <site
                        name="right_foot_contact"
                        pos="0.01 -0.046 -0.21"
                        size="0.005"
                        rgba="1 0 0 1"/>
                </body>
            </body>

            <!-- Left Leg -->
            <body name="Thigh_l"
                pos="0 -0.077 -0.0525">

                <inertial
                    pos="0.00025471 0.012591 -0.15857"
                    mass="0.1568"
                    fullinertia="0.00013318 0.00017067 6.0104e-05 
                    -1.9256e-08 -1.9188e-07 -5.934e-06"/>

                <joint
                    name="hip_joint_l"
                    axis="0 -0.99939 0.034899"
                    limited="true"
                    range="-90 90"/>

                <geom mesh="Left_Thigh"/>

                <body name="Shank_l"
                    pos="0 -0.0065611 -0.187885"
                    euler="-0.069813 0 0">

                    <inertial
                        pos="1.2553e-07 0.017802 -0.12331"
                        mass="0.071976"
                        fullinertia="8.0507e-05 8.5223e-05 1.6981e-05 
                        -1.3374e-11 -1.3431e-10 2.5123e-06"/>

                    <joint
                        name="knee_joint_l"
                        axis="0 -0.99939 -0.034899"
                        limited="true"
                        range="0 143"/>

                    <geom mesh="Left_Shank"/>

                    <geom
                        name="left_foot"
                        type="sphere"
                        pos="0.01 0.046 -0.19"
                        size="0.020"
                        friction="2 0.05 0.01"/>

                    <site
                        name="left_foot_contact"
                        pos="0.01 0.046 -0.21"
                        size="0.005"
                        rgba="1 0 0 1"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor
            name="hip_joint_right_act"
            joint="hip_joint_r"
            ctrllimited="true"
            ctrlrange="-12 12"/>
        <motor
            name="knee_joint_right_act"
            joint="knee_joint_r"
            ctrllimited="true"
            ctrlrange="-12 12"/>
        <motor
            name="hip_joint_left_act"
            joint="hip_joint_l"
            ctrllimited="true"
            ctrlrange="-12 12"/>
        <motor
            name="knee_joint_left_act"
            joint="knee_joint_l"
            ctrllimited="true"
            ctrlrange="-12 12"/>
    </actuator>

    <contact>
        <exclude body1="Hip" body2="Thigh_r"/>
        <exclude body1="Hip" body2="Thigh_l"/>
        <exclude body1="Thigh_r" body2="Shank_r"/>
        <exclude body1="Thigh_l" body2="Shank_l"/>
    </contact>

</mujoco>