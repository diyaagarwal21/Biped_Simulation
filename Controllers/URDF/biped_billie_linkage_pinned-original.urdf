<?xml version="1.0"?>
<robot name="biped_billie_linkage_pinned">

  <!-- Simplified linkage model.
       Root/reference frame: LeftFoot.
       Kinematic chain:
       LeftFoot -> LeftShin -> LeftThigh -> Torso
                -> RightThigh -> RightShin -> RightFoot
  -->

  <material name="dark_gray"><color rgba="0.25 0.25 0.25 1"/></material>
  <material name="light_gray"><color rgba="0.65 0.65 0.65 1"/></material>
  <material name="red"><color rgba="0.80 0.10 0.10 1"/></material>
  <material name="green"><color rgba="0.10 0.65 0.10 1"/></material>
  <material name="blue"><color rgba="0.10 0.20 0.80 1"/></material>

  <!-- Root link: fixed by loading this URDF as a fixed-base model. -->
  <link name="LeftFoot">
    <inertial>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <mass value="0.0287309120146299"/>
      <inertia ixx="4.148743695e-06" ixy="0" ixz="0"
               iyy="4.148743695e-06" iyz="0" izz="4.148743695e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>

  <!-- Ankle-to-knee distance: 0.2169998 m. -->
  <link name="LeftShin">
    <inertial>
      <origin xyz="0 0 0.1084999" rpy="0 0 0"/>
      <mass value="0.0432446610161898"/>
      <inertia ixx="1.7071e-04" ixy="0" ixz="0"
               iyy="1.7071e-04" iyz="0" izz="1.8019e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.1084999" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.2169998"/></geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1084999" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.2169998"/></geometry>
    </collision>
  </link>

  <joint name="LeftAnkle" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="LeftFoot"/>
    <child link="LeftShin"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.0" upper="2.0" effort="12" velocity="31"/>
  </joint>

  <!-- Knee-to-hip distance: 0.188 m. -->
  <link name="LeftThigh">
    <inertial>
      <origin xyz="0 0 0.094" rpy="0 0 0"/>
      <mass value="0.156796809757236"/>
      <inertia ixx="4.8225e-04" ixy="0" ixz="0"
               iyy="4.8225e-04" iyz="0" izz="6.5332e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.094" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.188"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.094" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.188"/></geometry>
    </collision>
  </link>

  <joint name="LeftKnee" type="revolute">
    <origin xyz="0 0 0.2169998" rpy="0 0 0"/>
    <parent link="LeftShin"/>
    <child link="LeftThigh"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.6" upper="0" effort="12" velocity="31"/>
  </joint>

  <!-- Hip spacing: 0.154 m in the y direction. -->
  <link name="Torso">
    <inertial>
      <origin xyz="0 0.077 0.10" rpy="0 0 0"/>
      <mass value="0.336117564776658"/>
      <inertia ixx="1.8547e-03" ixy="0" ixz="0"
               iyy="1.1484e-03" iyz="0" izz="8.5638e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0.077 0.025" rpy="0 0 0"/>
      <geometry><box size="0.08 0.230 0.05"/></geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0.077 0.10" rpy="0 0 0"/>
      <geometry><box size="0.08 0.154 0.05"/></geometry>
    </collision>
  </link>

  <joint name="LeftHip" type="revolute">
    <origin xyz="0 0 0.188" rpy="0 0 0"/>
    <parent link="LeftThigh"/>
    <child link="Torso"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5" upper="1.5" effort="12" velocity="31"/>
  </joint>

  <link name="RightThigh">
    <inertial>
      <origin xyz="0 0 -0.094" rpy="0 0 0"/>
      <mass value="0.156796809755688"/>
      <inertia ixx="4.8225e-04" ixy="0" ixz="0"
               iyy="4.8225e-04" iyz="0" izz="6.5332e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.094" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.188"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.094" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.188"/></geometry>
    </collision>
  </link>

  <joint name="RightHip" type="revolute">
    <origin xyz="0 0.154 0" rpy="0 0 0"/>
    <parent link="Torso"/>
    <child link="RightThigh"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5" upper="1.5" effort="12" velocity="31"/>
  </joint>

  <link name="RightShin">
    <inertial>
      <origin xyz="0 0 -0.1084999" rpy="0 0 0"/>
      <mass value="0.0432446610161898"/>
      <inertia ixx="1.7071e-04" ixy="0" ixz="0"
               iyy="1.7071e-04" iyz="0" izz="1.8019e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1084999" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.2169998"/></geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1084999" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.2169998"/></geometry>
    </collision>
  </link>

  <joint name="RightKnee" type="revolute">
    <origin xyz="0 0 -0.188" rpy="0 0 0"/>
    <parent link="RightThigh"/>
    <child link="RightShin"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="2.6" effort="12" velocity="31"/>
  </joint>

  <link name="RightFoot">
    <inertial>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <mass value="0.0287309120146299"/>
      <inertia ixx="4.148743695e-06" ixy="0" ixz="0"
               iyy="4.148743695e-06" iyz="0" izz="4.148743695e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0.019 0.019" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/>
      </geometry><material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>

  <joint name="RightAnkle" type="fixed">
    <origin xyz="0 -0.01625 -0.2169998" rpy="0 0 0"/>
    <parent link="RightShin"/>
    <child link="RightFoot"/>
  </joint>

</robot>
