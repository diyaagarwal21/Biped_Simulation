<mujoco model="biped">
    <compiler angle="degree"/>  <!-- use radians to define angles -->
    <option>
        <!-- Note: if using mujoco version earlier than 3, set <option collision="predefined"/> instead -->
        <flag contact="enable"/>
    </option>    
    <default>
        <!-- convert the Fusion 360 coordinate system to MuJoCo -->
        <mesh scale="1 1 1"/>
        <geom type="mesh" />
        <joint type="hinge" limited="true" axis="0 1 0"/>
        <!-- kp is proportional gain, kv is damping gain -->
        <position ctrllimited="true" kp="1" kv="0.1"/>
    </default>
    <asset>
        <!-- Fusion outputs meshes with mm units by default, but must be converted to m in MuJoCo, hence the scaling -->
        <mesh name="Hip" file="hip_updated.stl"/>
        <mesh name="Thigh" file="thigh_updated.stl"/>
        <mesh name="Shank" file="shank_updated.stl"/>
    </asset>
    <worldbody>
        <body name="Hip">
            <geom mesh="Hip"/>
            <joint name="base_z" type="slide" axis="0 0 1" pos="0 0 0" limited="false"/>
            <body name="Thigh" pos="0 0 0" >
                <joint name="hip_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-90 90"/>
                <geom mesh="Thigh"/>
                <body name="Shank" pos="0 0 -0.242">
                    <joint name="knee_joint" axis="0 1 0" limited="true" range="-90 90"/>
                    <geom mesh="Shank"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <position name="hip_joint" joint="hip_joint" ctrlrange="-5 5"/> 
        <position name="knee_joint" joint="knee_joint" ctrlrange="-5 5"/>
    </actuator>
    <contact>
        <exclude body1="Hip" body2="Thigh"/>
        <exclude body1="Thigh" body2="Shank"/>
    </contact>
</mujoco>