<mujoco model="biped">
    <compiler angle="degree"/> <!-- Use degrees to define angles -->
    <option>
        <flag contact="enable"/>
    </option>    
    <default>
        <mesh scale="1 1 1"/>
        <geom type="mesh" />
        <joint type="hinge" limited="true" axis="0 1 0"/>
        <position ctrllimited="true" kp="1" kv="0.1"/>
    </default>
    <asset>
        <!-- Reused assets for both legs -->
        <mesh name="Hip" file="hip_updated.stl"/>
        <mesh name="Thigh" file="thigh_updated.stl"/>
        <mesh name="Shank" file="shank_updated.stl"/>
    </asset>
    <worldbody>
        <body name="Hip">
            <geom mesh="Hip"/>
            <joint name="base_z" type="slide" axis="0 0 1" pos="0 0 0" limited="false"/>

            <!-- First leg (left) -->
            <body name="Thigh_Left" pos="0.1 0 0">
                <joint name="hip_joint_left" pos="0 0 0" axis="0 1 0" limited="true" range="-90 90"/>
                <geom mesh="Thigh"/>
                <body name="Shank_Left" pos="0 0 -0.242">
                    <joint name="knee_joint_left" axis="0 1 0" limited="true" range="-90 90"/>
                    <geom mesh="Shank"/>
                </body>
            </body>

            <!-- Second leg (right) -->
            <body name="Thigh_Right" pos="-0.1 0 0">
                <joint name="hip_joint_right" pos="0 0 0" axis="0 1 0" limited="true" range="-90 90"/>
                <geom mesh="Thigh"/>
                <body name="Shank_Right" pos="0 0 -0.242">
                    <joint name="knee_joint_right" axis="0 1 0" limited="true" range="-90 90"/>
                    <geom mesh="Shank"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <!-- Actuators for the left leg -->
        <position name="hip_joint_left_act" joint="hip_joint_left" ctrlrange="-5 5"/> 
        <position name="knee_joint_left_act" joint="knee_joint_left" ctrlrange="-5 5"/>

        <!-- Actuators for the right leg -->
        <position name="hip_joint_right_act" joint="hip_joint_right" ctrlrange="-5 5"/> 
        <position name="knee_joint_right_act" joint="knee_joint_right" ctrlrange="-5 5"/>
    </actuator>

    <contact>
        <!-- Exclude collisions between connected parts -->
        <exclude body1="Hip" body2="Thigh_Left"/>
        <exclude body1="Thigh_Left" body2="Shank_Left"/>
        <exclude body1="Hip" body2="Thigh_Right"/>
        <exclude body1="Thigh_Right" body2="Shank_Right"/>
    </contact>
</mujoco>
