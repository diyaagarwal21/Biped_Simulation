<mujoco model="biped">
    <compiler angle="degree"/>  <!-- use radians to define angles -->
    <option>
        <flag contact="enable"/>
    </option>    
    <default>
        <mesh scale="1 1 1"/>
        <geom type="mesh" />
        <joint type="hinge" limited="true" axis="0 1 0"/>
        <position ctrllimited="true" kp="1" kv="0.1"/>
    </default>
    <asset>
        <!-- Fusion outputs meshes with mm units by default, but must be converted to m in MuJoCo, hence the scaling -->
        <mesh name="Hip" file="double_hip_updated.stl"/>
        <mesh name="Thigh" file="double_thigh_updated.stl"/>
        <mesh name="Shank" file="double_shank_updated.stl"/>
    </asset>
    <worldbody>
        <body name="Hip">
            <geom mesh="Hip"/>
            <joint name="base_z" type="slide" axis="0 0 1" pos="0 0 0" limited="false"/>
            
            <!-- First leg (right) -->
            <body name="Thigh_r" pos="0 0 0" >
                <joint name="hip_joint_r" pos="0 0 0" axis="0 1 0" limited="true" range="-90 90"/>
                <geom mesh="Thigh"/>
                <body name="Shank_r" pos="0 0 -0.183">
                    <joint name="knee_joint_r" axis="0 1 0" limited="true" range="-90 90"/>
                    <geom mesh="Shank"/>
                </body>
            </body>

            <!-- Second leg (left) -->
            <body name="Thigh_l" pos="0 0.1 0" >
                <joint name="hip_joint_l" pos="0 0 0" axis="0 1 0" limited="true" range="-90 90"/>
                <geom mesh="Thigh"/>
                <body name="Shank_l" pos="0 0 -0.183">
                    <joint name="knee_joint_l" axis="0 1 0" limited="true" range="-90 90"/>
                    <geom mesh="Shank"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <!-- Actuators for the right leg -->
        <position name="hip_joint_right_act" joint="hip_joint_r" ctrlrange="-5 5"/> 
        <position name="knee_joint_right_act" joint="knee_joint_r" ctrlrange="-5 5"/>

        <!-- Actuators for the left leg -->
        <position name="hip_joint_left_act" joint="hip_joint_l" ctrlrange="-5 5"/> 
        <position name="knee_joint_left_act" joint="knee_joint_l" ctrlrange="-5 5"/>
    </actuator>
    <contact>
        <exclude body1="Hip" body2="Thigh_r"/>
        <exclude body1="Hip" body2="Thigh_l"/>
        <exclude body1="Thigh_r" body2="Shank_r"/>
        <exclude body1="Thigh_l" body2="Shank_l"/>
    </contact>
</mujoco>